# ===================================================
# NOVA AI ASSISTANT - ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env.local and fill in real values.
# NEVER COMMIT .env or .env.local to Git!
# ===================================================

# 1. AI Models (Gemini & Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 2. Supabase (Database, Auth, Vectors)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# 3. Upstash Redis (Caching & Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"
REDIS_URL="rediss://default:token@your-upstash-redis.upstash.io:6379"

# 4. Tavily (Live Web Search)
TAVILY_API_KEY=your_tavily_api_key_here

# 5. ElevenLabs (Voice Synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# 6. Backend & Railway
BACKEND_URL=https://nova-backend-production.up.railway.app
RAILWAY_TOKEN=your_railway_deploy_token_here

# 7. Frontend & Vercel
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_vercel_project_id_here
VERCEL_ORG_ID=your_vercel_org_id_here

# 8. GitHub Integration
GITHUB_REPO_URL=https://github.com/rohith-jp/NOVA
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
