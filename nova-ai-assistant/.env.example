# ===================================================
# NOVA AI ASSISTANT - ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER COMMIT REAL KEYS OR .env FILES TO GIT!
# ===================================================

# 1. AI Models
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 2. Supabase (Database, Auth, Vectors)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:password@db.your-supabase-project.supabase.co:5432/postgres

# 3. Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379

# 4. Search & Voice APIs
TAVILY_API_KEY=your_tavily_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# 5. Application URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000
GITHUB_REPO_URL=https://github.com/rohith-jp/NOVA
