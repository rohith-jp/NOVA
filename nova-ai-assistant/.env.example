# ============================================================
# NOVA AI Assistant — Environment Variable Template
#
# ► Copy to .env for local development and fill in real values.
# ► For Railway: add each variable in the Railway dashboard under
#   the service's "Variables" tab. NEVER commit real secrets.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct Postgres connection (used by migrate.py)
# Format: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─── Redis / Upstash ─────────────────────────────────────────
# Upstash Console > Redis > Database > Connect > @upstash/redis
# Must use rediss:// (TLS) for Upstash
REDIS_URL=rediss://:your_upstash_redis_password@your-upstash-endpoint.upstash.io:6379

# ─── AI: Google Gemini ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── AI: Anthropic Claude ────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── AI: Groq (optional fast inference) ─────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── AI: OpenAI Whisper (Speech-to-Text) ─────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Search: Tavily ──────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ─── Voice: ElevenLabs (Text-to-Speech) ──────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice ID — leave blank to use code default (Rachel voice)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ─── Security ────────────────────────────────────────────────
# 32+ char random string used to derive the AES-256-GCM encryption key.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Changing this key makes all existing encrypted memories unreadable.
ENCRYPTION_SECRET_KEY=generate_a_strong_random_secret_here

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
# Add your Railway frontend URL and/or Vercel URL here
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.up.railway.app

# ─── Application URLs ────────────────────────────────────────
# Set BACKEND_URL to your Railway backend public URL after deployment
BACKEND_URL=https://your-backend.up.railway.app
FRONTEND_URL=https://your-frontend.up.railway.app

# ─── Celery Worker tuning (optional) ─────────────────────────
# Number of concurrent worker processes (default: 2)
CELERYD_CONCURRENCY=2
